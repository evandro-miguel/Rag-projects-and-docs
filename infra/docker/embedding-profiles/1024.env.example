# Host-side local llama.cpp profile used by rag-ops init --embedding-profile 1024.
# Keep the listener on loopback; the optional Docker worker uses its own
# host-gateway URL and must be enabled deliberately.
RAG_LOCAL_EMBEDDING_PROFILE=1024
PROJECT_RAG_PG_EMBEDDING_BASE_URL=http://127.0.0.1:8082
PROJECT_RAG_PG_EMBEDDING_MODEL=qwen3-embedding-1024
PROJECT_RAG_PG_EMBEDDING_DIMENSIONS=1024
