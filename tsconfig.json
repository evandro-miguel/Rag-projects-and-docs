{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "bun", "vitest/globals"]
  },
  "include": ["scripts/**/*", "mcp/**/*", "lib/**/*"],
  "exclude": ["node_modules", "scripts/query-docs.ts"]
}
