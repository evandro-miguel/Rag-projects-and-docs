{
  "name": "@ozy/rag-docs",
  "version": "0.1.0-alpha.0",
  "description": "Self-hosted RAG platform for AI coding agents using Bun, TypeScript, Postgres, local embeddings, and MCP.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evandro-miguel/Rag-projects-and-docs.git"
  },
  "homepage": "https://github.com/evandro-miguel/Rag-projects-and-docs#readme",
  "bugs": {
    "url": "https://github.com/evandro-miguel/Rag-projects-and-docs/issues"
  },
  "bin": {
    "ragctl": "./bin/ragctl"
  },
  "scripts": {
    "ingest-project": "bun run scripts/project-rag/ingest-package.ts",
    "ingest-project-rag": "bun run scripts/project-rag/ingest-package.ts",
    "ingest:project-rag": "bun run scripts/project-rag/ingest-package.ts",
    "embed:project-rag:postgres": "bun run scripts/project-rag/embed-postgres.ts",
    "search:project-rag:postgres": "bun run scripts/project-rag/search-postgres.ts",
    "verify:project-rag:postgres": "bun run scripts/project-rag/verify-postgres.ts",
    "project-rag:worker": "bun run scripts/project-rag/job-worker.ts",
    "db:migrations": "bun run scripts/db-migrations/cli.ts",
    "register-project": "bun run scripts/project-rag/register-package.ts",
    "review-project-rag-snapshot": "bun run scripts/project-rag/review-snapshot.ts",
    "sync:external": "bun scripts/sync-external-docs.ts",
    "sync": "bun run sync:external",
    "health:docs-rag": "tsx scripts/check-docs-rag-freshness.ts",
    "docs-rag:lab": "bun run scripts/docs-rag/index.ts",
    "eval:docs-live": "DOCS_RAG_PG_LAB_ENABLE_LIVE_SEARCH=true bun run docs-rag:lab eval --dataset scripts/docs-rag/fixtures/eval-external-sources.json --live-search --allow-live-search --require-pass",
    "watch-project": "bun run scripts/watch-project.ts",
    "verify": "bun run verify:docs-rag-live",
    "verify:docs-rag-live": "bash scripts/verify-docs-rag-live.sh",
    "verify:docs-rag-live:keyword": "echo \"verify:docs-rag-live:keyword was removed because keyword fallback is not a finalization gate. Use ./bin/ragctl docs search --mode keyword for manual smoke checks.\" && exit 1",
    "health:embeddings": "tsx scripts/check-embedding-health.ts --project-rag",
    "health:embeddings:project": "tsx scripts/check-embedding-health.ts --project-rag",
    "health:embeddings:compat4096": "EMBEDDING_PROVIDER=llamacpp LLAMACPP_BASE_URL=${PROJECT_RAG_4096_BASE_URL:-http://127.0.0.1:8081} LLAMACPP_EMBEDDING_MODEL=${PROJECT_RAG_4096_MODEL:-qwen3-embedding} EMBEDDING_EXPECTED_DIMENSIONS=4096 tsx scripts/check-embedding-health.ts",
    "health:embeddings:docs-live": "EMBEDDING_PROVIDER=llamacpp LLAMACPP_BASE_URL=${DOCS_RAG_PG_LAB_EMBEDDING_BASE_URL:-http://127.0.0.1:8082} LLAMACPP_EMBEDDING_MODEL=${DOCS_RAG_PG_LAB_EMBEDDING_MODEL:-qwen3-embedding-1024} EMBEDDING_EXPECTED_DIMENSIONS=1024 tsx scripts/check-embedding-health.ts",
    "embeddings:gpu": "bash scripts/start-llamacpp-embedding-gpu.sh",
    "embeddings:gpu:1024": "LLAMACPP_EMBEDDING_MODEL=${LLAMACPP_EMBEDDING_MODEL:-qwen3-embedding-1024} LLAMACPP_PORT=${LLAMACPP_PORT:-8082} LLAMACPP_POOLING=${LLAMACPP_POOLING:-last} bash scripts/start-llamacpp-embedding-gpu.sh",
    "preeval": "LLAMACPP_BASE_URL=${DOCS_RAG_PG_LAB_EMBEDDING_BASE_URL:-http://127.0.0.1:8082} LLAMACPP_EMBEDDING_MODEL=${DOCS_RAG_PG_LAB_EMBEDDING_MODEL:-qwen3-embedding-1024} tsx scripts/ensure-embedding-provider.ts && bun run health:embeddings:docs-live -- --readiness-only",
    "preeval:docs-live": "bun run preeval",
    "mcp": "bun run mcp/launcher.ts",
    "mcp:edit-session": "RAG_PROJECT_SESSION_INTENT=edit_session bun run mcp/launcher.ts",
    "mcp:http": "bun run mcp/index.ts",
    "eval": "bash scripts/rag-ops.sh eval-docs",
    "eval:raw": "bun run verify:docs-rag-live",
    "eval:run": "bun run eval:mcp-live",
    "eval:project-rag": "tsx scripts/check-embedding-health.ts --project-rag --quiet --readiness-only && RAG_PROJECT_WATCHER_ENABLED=false bun run scripts/eval/project-rag/run-e2e-eval.ts",
    "eval:project-rag:report": "tsx scripts/eval/project-rag/run-project-rag-eval.ts",
    "eval:project-rag:gate-policy": "tsx scripts/eval/project-rag/gate-policy.ts",
    "eval:capture": "tsx scripts/eval/capture-baseline.ts",
    "eval:check": "bun run verify:docs-rag-live",
    "eval:mcp-live": "bash scripts/rag-ops.sh eval-mcp-live",
    "eval:mcp-live:full": "RAG_PROJECT_WATCHER_ENABLED=false PROJECT_RAG_PROJECT_SLUG=${PROJECT_RAG_PROJECT_SLUG:-rag-v2-dev} bun run scripts/eval/mcp-live-harness.ts --project-root \"$PWD\"",
    "eval:mcp-live:ingest": "MCP_PERMISSION_MODE=read_write RAG_PROJECT_WATCHER_ENABLED=false bun run scripts/eval/mcp-live-harness.ts --ingest-project",
    "eval:mcp-live:edit-session": "MCP_PERMISSION_MODE=read_write RAG_PROJECT_WATCHER_ENABLED=false RAG_PROJECT_SESSION_INTENT=edit_session bun run scripts/eval/mcp-live-harness.ts --edit-session --project-root \"$PWD\"",
    "eval:mcp-project-current": "tsx scripts/check-embedding-health.ts --project-rag --quiet --readiness-only && RAG_MCP_PROJECT_CURRENT_MUTATION_ACK=1 RAG_PROJECT_WATCHER_ENABLED=false tsx scripts/eval/mcp-project-current.ts contract",
    "eval:mcp-project-current:repair": "tsx scripts/check-embedding-health.ts --project-rag --quiet --readiness-only && RAG_MCP_PROJECT_CURRENT_MUTATION_ACK=1 RAG_PROJECT_WATCHER_ENABLED=false tsx scripts/eval/mcp-project-current.ts repair",
    "eval:mcp-matrix": "tsx scripts/eval/mcp-tool-matrix.ts",
    "eval:mcp-concurrency": "RAG_PROJECT_WATCHER_ENABLED=false MCP_PERMISSION_MODE=read_only bun run scripts/eval/mcp-concurrency-harness.ts --transport stdio",
    "eval:mcp-concurrency:http": "RAG_PROJECT_WATCHER_ENABLED=false MCP_PERMISSION_MODE=read_only bun run scripts/eval/mcp-concurrency-harness.ts --transport http --endpoint ${MCP_HTTP_ENDPOINT:-http://127.0.0.1:3333/mcp}",
    "gate:release:plan": "tsx scripts/eval/release-gate-matrix.ts --plan --json",
    "gate:release": "tsx scripts/eval/release-gate-matrix.ts --run",
    "validate:release": "bun run gate:release",
    "bench:mcp-concurrency": "bun run eval:mcp-concurrency",
    "eval:codex-mcp": "bun run scripts/eval/codex-mcp-smoke.ts --docs-only --strict-codex",
    "eval:codex-mcp:full": "bun run scripts/eval/codex-mcp-smoke.ts --strict-codex",
    "eval:agent-mcp": "tsx scripts/eval/agent-mcp-eval.ts",
    "eval:docs-cleanliness": "tsx scripts/eval/docs-cleanliness-audit.ts",
    "eval:llm-pilot": "tsx scripts/eval/llm-cleaning-pilot.ts",
    "eval:kg": "tsx scripts/eval/check-kg-coverage.ts",
    "eval:all": "bun run verify:docs-rag-live && bun run eval:mcp-live",
    "kg:backfill-docs": "tsx scripts/backfill-docs-kg.ts",
    "bench:project-embedding-profiles": "bun run scripts/benchmarks/project-rag-embedding-profiles.ts",
    "bench:project-embedding-profiles:real": "bun run scripts/benchmarks/project-rag-real-embedding-profiles.ts",
    "bench:docs-rag-real": "bun run scripts/benchmarks/docs-rag-real.ts",
    "bench:reranker-dtypes": "bun run scripts/benchmarks/reranker-dtypes.ts",
    "backfill:project-rag:postgres:symbols": "bun run scripts/project-rag/backfill-symbols.ts",
    "backfill:project-rag:postgres:edges": "bun run scripts/project-rag/backfill-edges.ts",
    "bench:project-search": "bun run scripts/benchmarks/project-search-latency.ts",
    "bench:codex-mcp": "tsx scripts/benchmarks/codex-mcp-reliability.ts --timeout-ms 240000 --project-root \"$PWD/scripts/eval/project-rag/repos/fixture-ts-service\" --include-roots src,docs --project-query loginUser",
    "bench:system": "tsx scripts/benchmarks/system-benchmark.ts",
    "verify:project": "tsx scripts/check-embedding-health.ts --project-rag --quiet --readiness-only && RAG_MCP_PROJECT_CURRENT_MUTATION_ACK=1 bun run scripts/verify-project-index.ts",
    "verify:project-rag": "tsx scripts/check-embedding-health.ts --project-rag --quiet --readiness-only && RAG_MCP_PROJECT_CURRENT_MUTATION_ACK=1 bun run scripts/verify-project-index.ts",
    "repair:project": "tsx scripts/check-embedding-health.ts --project-rag --quiet --readiness-only && RAG_MCP_PROJECT_CURRENT_MUTATION_ACK=1 bun run scripts/verify-project-index.ts repair",
    "reranker:service": "bun run scripts/reranking-service.ts",
    "reranker:test": "bun run scripts/test-reranking.ts",
    "ragctl": "bun run scripts/ragctl.ts",
    "rag:init": "bash scripts/rag-ops.sh init",
    "rag:start": "bash scripts/rag-ops.sh up",
    "rag:stop": "bash scripts/rag-ops.sh down",
    "rag:status": "bash scripts/rag-ops.sh status",
    "rag:doctor": "bash scripts/rag-ops.sh doctor",
    "rag:daemon:start": "bun run scripts/rag-daemon.ts start",
    "rag:daemon:stop": "bun run scripts/rag-daemon.ts stop",
    "rag:daemon:status": "bun run scripts/rag-daemon.ts status",
    "ensure:reranker": "bash scripts/ensure-reranker.sh",
    "inventory": "tsx scripts/maintain-inventory.ts",
    "lint": "bun x @biomejs/biome check biome.json package.json vitest.config.ts vitest.setup.ts mcp lib scripts",
    "format": "bun x @biomejs/biome check --write biome.json package.json vitest.config.ts vitest.setup.ts mcp lib scripts",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:coverage:rag-quality": "vitest run --config vitest.rag-quality.config.ts --coverage scripts/ensure-embedding-provider.test.ts scripts/docs-rag/eval.test.ts scripts/docs-rag/store.test.ts scripts/lib/tests/docs-corpus-readiness.test.ts scripts/lib/tests/docs-readiness.test.ts scripts/lib/tests/external-doc-inventory.test.ts scripts/lib/tests/external-doc-quality.test.ts scripts/lib/tests/sync-external-docs.dry-run.test.ts tests/docs-rag/lab.test.ts scripts/ragctl.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:project-rag:snapshot-gate:real": "PROJECT_RAG_REAL_DB_TEST=1 bun --bun x vitest run scripts/project-rag/snapshot-gate.postgres.integration.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.2.2",
    "@langchain/textsplitters": "1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "8.5.2",
    "glob": "^13.0.6",
    "hono": "^4.13.5",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^28.0.0",
    "web-tree-sitter": "^0.26.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@edge-runtime/vm": "^5.0.0",
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "tree-sitter-javascript",
    "tree-sitter-python"
  ],
  "overrides": {
    "hono": "^4.13.5",
    "body-parser": "^2.3.0",
    "adm-zip": "^0.6.1",
    "tar": "^7.5.11",
    "ajv": "^8.18.0",
    "rollup": "^4.59.0",
    "@hono/node-server": "^1.19.15",
    "qs": "^6.16.0",
    "langsmith": "^0.6.0",
    "vite": "^7.3.5",
    "picomatch": "^4.0.4",
    "path-to-regexp": "^8.4.0",
    "minimatch": "^10.2.3",
    "@isaacs/brace-expansion": "^5.0.1",
    "fast-uri": "^3.1.5",
    "ws": "^8.21.0",
    "protobufjs": "^7.5.6",
    "postcss": "^8.5.23",
    "uuid": "^11.1.1",
    "ip-address": "^10.3.1",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.4"
  }
}
